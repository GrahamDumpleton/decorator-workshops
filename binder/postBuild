#!/bin/bash
# Configure the Binder image so JupyterLab starts in the workshop browser
# with the decorator workshops listed as installed and ready to open, and
# trusts them without asking, since the visitor is the one who chose the
# link. A launch link naming a workshop still opens that workshop
# directly. The disabled features keep visitors to the supplied
# workshops: no other directories or URLs, no subscribing to collections
# or catalogs, no removing and no editing; Restart puts a workshop back
# as it started. Subscribing to the checkout's own collection.json lists
# the workshops in the collection's order, numbered, under its title.
# The welcome message in binder/welcome.md greets the visitor once the
# session starts, with what the workshops are for and how to end it.
# The analytics setting reports every session's progress events to the
# sink the collection.json analytics block names, the workshops' own
# analytics service, without asking, so it can be seen where the
# workshops are clear and where they are not. The sink and its token
# are declared once, in the index, and this only turns reporting on;
# the events say they came from Binder. Sessions are anonymous and the
# events never carry file contents, command output or form answers;
# the welcome message tells the visitor that progress is reported.
#
# There is nothing to install for the workshops themselves. They are
# standard library only, with no environment key and no requirements of
# their own, so the ambient kernel Binder builds from
# binder/requirements.txt is the whole environment and this script only
# writes settings.
# The second block is JupyterLab's own: it turns off the question about
# fetching Jupyter news, which a fresh container would otherwise put in
# front of every visitor before the welcome message.
set -euo pipefail

settings="${NB_PYTHON_PREFIX}/share/jupyter/lab/settings"

mkdir -p "$settings"

cat > "$settings/overrides.json" <<'JSON'
{
  "@jupyterlab-workshop/labextension:panel": {
    "defaultWorkshop": "",
    "browseOnStart": true,
    "workshopsDirectory": "workshops",
    "collections": ["collection.json"],
    "welcome": "binder/welcome.md",
    "trustPolicy": { "forcedLevel": "trusted" },
    "disabledFeatures": [
      "open-directory",
      "open-url",
      "collections",
      "catalogs",
      "remove",
      "author"
    ],
    "analytics": { "report": "always" }
  },
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false"
  }
}
JSON

echo "Wrote the JupyterLab overrides to $settings/overrides.json"
